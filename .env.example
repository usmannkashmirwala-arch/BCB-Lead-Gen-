# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it is listed in .gitignore.

# Google service account key JSON (full JSON on one line)
# Get this from Google Cloud Console → IAM → Service Accounts → Keys → Create key (JSON)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_PROJECT","private_key_id":"KEY_ID","private_key":"-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY\n-----END RSA PRIVATE KEY-----\n","client_email":"your-sa@your-project.iam.gserviceaccount.com","client_id":"CLIENT_ID","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Google Sheet workbook ID (from the URL: /spreadsheets/d/<ID>/edit)
GOOGLE_SHEET_ID=your_sheet_id_here

# Vibe Prospecting API key (vibeprospecting.ai → Settings → API)
VIBEPROSPECTING_API_KEY=your-vibe-prospecting-api-key-here

# Google Maps Platform API key (must have Places API enabled)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
